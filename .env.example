# Docker Compose data services
POSTGRES_USER=fabbi
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_DB=postgres
REDIS_PASSWORD=replace-with-a-local-redis-password

# Backend connection URLs inside the Compose network. Keep these credentials in
# sync with the service passwords above and URL-encode special characters.
DATABASE_URL=postgresql+asyncpg://fabbi:replace-with-a-local-database-password@postgres:5432/postgres
REDIS_URL=redis://:replace-with-a-local-redis-password@redis:6379/0

# JWT
JWT_SECRET=replace-with-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Browser origins allowed to call the credentialed API. Use a comma-separated
# allowlist; wildcards are rejected.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:4173

# Keep SQL and parameter logging disabled unless diagnosing a local issue.
DB_ECHO=false

# Frontend
VITE_API_URL=http://localhost:8000

# Optional seed sizes
SEED_USERS=100
SEED_TODOS=1000
