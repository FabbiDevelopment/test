# Local backend defaults
DATABASE_URL=postgresql+asyncpg://fabbi:replace-with-a-strong-password@localhost:5432/postgres
REDIS_URL=redis://:replace-with-a-strong-password@localhost:6379/0
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Docker Compose
POSTGRES_USER=fabbi
POSTGRES_PASSWORD=replace-with-a-url-safe-password
POSTGRES_DB=postgres
REDIS_PASSWORD=replace-with-a-url-safe-password
JWT_SECRET=replace-with-at-least-32-random-characters
VITE_API_URL=http://localhost:8000

# Optional seed sizes
SEED_USERS=100
SEED_TODOS=1000