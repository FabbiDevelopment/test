# Production Environment Variables Template
# Copy this file to .env.prod on the production server and fill in real values.
# NEVER commit .env.prod with real secrets to Git.

# PostgreSQL Configuration
POSTGRES_USER=fabbi_prod_user
POSTGRES_PASSWORD=generate_a_strong_database_password_here
POSTGRES_DB=fabbi_todo_prod

# Redis Configuration
REDIS_PASSWORD=generate_a_strong_redis_password_here

# Application Secrets
JWT_SECRET=generate_a_cryptographically_secure_256bit_random_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend Configuration
VITE_API_URL=https://api.yourdomain.com
