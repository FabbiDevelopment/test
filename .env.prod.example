# Copy this file to .env.prod and fill in real values.
# .env.prod itself must NEVER be committed (see .gitignore) - generate
# strong random values for a real deployment, these are placeholders only.
#
#   openssl rand -hex 32   # good way to generate JWT_SECRET / passwords

POSTGRES_PASSWORD=change-me-to-a-strong-random-password
REDIS_PASSWORD=change-me-to-a-strong-random-password
JWT_SECRET=change-me-to-a-strong-random-secret

# Public URL the frontend should call (e.g. https://api.yourdomain.com).
# Defaults to http://localhost:8000 if unset.
PUBLIC_API_URL=
