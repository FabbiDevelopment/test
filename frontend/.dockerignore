# Frontend .dockerignore
# Excludes large directories and dev artifacts from the build context

# Node modules (will be installed inside Docker)
node_modules/

# Build output (will be rebuilt inside Docker)
dist/
build/

# Secrets & local config
.env
.env.local
.env.*.local

# Test & E2E
e2e/
playwright-report/
test-results/

# Editor & OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Git
.git/
.gitignore

# Docker files (not needed inside the image)
Dockerfile
.dockerignore
